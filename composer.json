{
  "name": "vitormattos/vitormattos.github.io",
  "description": "Personal site, articles, talks and public work built with Jigsaw.",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "tightenco/jigsaw": "^1.8.8",
    "samdark/sitemap": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Listeners\\": "listeners/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "build": "npm run build",
    "serve": "npm run dev",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
    "cs:fix": "php-cs-fixer fix --allow-risky=yes",
    "test": "phpunit --colors=always --fail-on-warning --fail-on-risky"
  }
}
